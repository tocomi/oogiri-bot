SLACK_BOT_TOKEN=xoxb-xxx
SLACK_TEAM_ID=TXXX
SLACK_CHANNEL_ID=CXXX
SLACK_SIGNING_SECRET=xxx
# 開発用の Socket Mode (pnpm dev:socket) でのみ使う App-Level Token (connections:write)
